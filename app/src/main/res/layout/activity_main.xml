<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    tools:openDrawer="end"
    android:id="@+id/gradeDrawer"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/main_text_background"
        android:padding="5dp"
        android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text= "@string/enter_prev_cgpa_total_cr_hours"
        android:textColor="@color/light_green"
        android:textStyle="bold"
        android:textSize="22sp"
        android:gravity="center"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/rounded_row"
        android:layout_margin="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CGPA : "
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginStart="4dp"
            android:textColor="@color/red"
            />

        <EditText
            android:id="@+id/PrevCGPA"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColorHint="@color/hintBlack"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:hint="@string/enter_prev_cgpa"
            android:inputType="numberDecimal"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="C.hrs : "
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginStart="4dp"
            android:textColor="@color/red"
            />

        <EditText
            android:id="@+id/TotalCredit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColorHint="@color/hintBlack"
            android:hint="@string/enter_total_credit_hours"
            android:inputType="numberDecimal"/>

    </LinearLayout>


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text= "@string/select_your_grade_credit_hours"
        android:textColor="@color/light_green"
        android:textStyle="bold"
        android:textSize="22sp"
        android:gravity="center"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        />

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:stretchColumns="1,3">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_row_blue">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text= "No."
                android:textColor="@color/cream"
                android:textStyle="bold"
                android:textSize="22sp"
                android:gravity="center"
                android:layout_column="1"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text= "  Grade"
                android:textColor="@color/cream"
                android:textStyle="bold"
                android:textSize="22sp"
                android:layout_column="2"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text= "Points"
                android:textColor="@color/cream"
                android:textStyle="bold"
                android:gravity="center"
                android:textSize="22sp"
                android:layout_column="3"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text= "  Credit"
                android:textColor="@color/cream"
                android:textStyle="bold"
                android:textSize="22sp"
                android:layout_column="4"
                />

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rounded_row">
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text= "1."
                android:textColor="@color/red"
                android:textSize="21sp"
                android:gravity="center"
                android:textStyle="bold"
                android:layout_column="1"
                />
            <Spinner
                android:id="@+id/gradeList1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <TextView
                android:id="@+id/point1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text= ""
                android:textColor="@color/black"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_column="3"
                />
            <Spinner
                android:id="@+id/creditList1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>


        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_row"
            android:layout_marginTop="3dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text= "2."
                android:textColor="@color/red"
                android:textSize="21sp"
                android:gravity="center"
                android:textStyle="bold"
                android:layout_column="1"
                />
            <Spinner
                android:id="@+id/gradeList2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <TextView
                android:id="@+id/point2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text= ""
                android:textColor="@color/black"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_column="3"
                />
            <Spinner
                android:id="@+id/creditList2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>


        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_row"
            android:layout_marginTop="3dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text= "3."
                android:textColor="@color/red"
                android:textSize="21sp"
                android:gravity="center"
                android:textStyle="bold"
                android:layout_column="1"
                />
            <Spinner
                android:id="@+id/gradeList3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <TextView
                android:id="@+id/point3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text= ""
                android:textColor="@color/black"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_column="3"
                />
            <Spinner
                android:id="@+id/creditList3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_row"
            android:layout_marginTop="3dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text= "4."
                android:textColor="@color/red"
                android:textSize="21sp"
                android:gravity="center"
                android:textStyle="bold"
                android:layout_column="1"
                />
            <Spinner
                android:id="@+id/gradeList4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <TextView
                android:id="@+id/point4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text= ""
                android:textColor="@color/black"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_column="3"
                />
            <Spinner
                android:id="@+id/creditList4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_row"
            android:layout_marginTop="3dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text= "5."
                android:textColor="@color/red"
                android:textSize="21sp"
                android:gravity="center"
                android:textStyle="bold"
                android:layout_column="1"
                />
            <Spinner
                android:id="@+id/gradeList5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <TextView
                android:id="@+id/point5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text= ""
                android:textColor="@color/black"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_column="3"
                />
            <Spinner
                android:id="@+id/creditList5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_row"
            android:layout_marginTop="3dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text= "6."
                android:textColor="@color/red"
                android:textSize="21sp"
                android:gravity="center"
                android:textStyle="bold"
                android:layout_column="1"
                />
            <Spinner
                android:id="@+id/gradeList6"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <TextView
                android:id="@+id/point6"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text= ""
                android:textColor="@color/black"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_column="3"
                />
            <Spinner
                android:id="@+id/creditList6"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_row"
            android:layout_marginTop="3dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text= "7."
                android:textColor="@color/red"
                android:textSize="21sp"
                android:gravity="center"
                android:textStyle="bold"
                android:layout_column="1"
                />
            <Spinner
                android:id="@+id/gradeList7"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <TextView
                android:id="@+id/point7"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text= ""
                android:textColor="@color/black"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_column="3"
                />
            <Spinner
                android:id="@+id/creditList7"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_row"
            android:layout_marginTop="3dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text= "8."
                android:textColor="@color/red"
                android:textSize="21sp"
                android:gravity="center"
                android:textStyle="bold"
                android:layout_column="1"
                />
            <Spinner
                android:id="@+id/gradeList8"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <TextView
                android:id="@+id/point8"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text= ""
                android:textColor="@color/black"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_column="3"
                />
            <Spinner
                android:id="@+id/creditList8"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

        </TableRow>

    </TableLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:gravity="center">

        <Button
            android:id="@+id/reset"
            android:layout_width="wrap_content"
            android:layout_height="55dp"
            android:text="Reset"
            android:layout_marginRight="40dp"
            android:backgroundTint="@color/dark_red"/>
        <Button
            android:id="@+id/calculate"
            android:layout_width="wrap_content"
            android:layout_height="55dp"
            android:text="Calculate"
            android:backgroundTint="@color/dark_green"/>

    </LinearLayout>

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="wrap_content"
        android:layout_height="400dp"
        android:fitsSystemWindows="true"
        android:layout_gravity="end"
        app:headerLayout="@layout/grade_header_layout"
        />

</androidx.drawerlayout.widget.DrawerLayout>